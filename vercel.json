{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "api": {
    "baseDirectory": "api"
  },
  "env": {
    "DB_HOST": "@db_host",
    "DB_PORT": "@db_port",
    "DB_USER": "@db_user",
    "DB_PASSWORD": "@db_password",
    "DB_DATABASE": "@db_database",
    "CORS_ORIGIN": "@cors_origin"
  }
}
